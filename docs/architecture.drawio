      <mxGeometry x="100" y="280" width="220" height="140" as="geometry" />
    </mxCell>

    <!-- Component: Catalog Controller -->
    <mxCell id="catalog_controller" value="&lt;b&gt;Catalog Controller&lt;/b&gt;&#xa;[Component: Spring MVC]&#xa;&#xa;Exposes REST endpoints for querying product catalog and search." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#85bbf0;fontColor=#ffffff;strokeColor=#5c9cd8;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="500" y="280" width="220" height="140" as="geometry" />
