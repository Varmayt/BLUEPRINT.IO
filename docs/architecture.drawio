<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1100">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    
    <!-- Boundary/Container Box -->
    <mxCell id="boundary" value="API Application&#xa;[Container: Spring Boot / Java]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#8C8C8C;strokeWidth=2;dashed=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=10;fontColor=#8C8C8C;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="50" y="210" width="1120" height="580" as="geometry" />
    </mxCell>

    <!-- External Client: Web SPA -->
    <mxCell id="web_spa" value="&lt;b&gt;Web Application&lt;/b&gt;&#xa;[Container: React/SPA]&#xa;&#xa;Provides the user interface for catalog browsing, shopping cart, and checkout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168bd;fontColor=#ffffff;strokeColor=#0b4c8c;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="500" y="30" width="220" height="140" as="geometry" />
